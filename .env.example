# Copy to `.env` (git-ignored) and fill in. `make` auto-loads it.
# These are SECRETS — never commit the real .env.

# Apple Developer ID notarization (for signed .dmg + releases)
APPLE_ID="you@example.com"
APPLE_APP_SPECIFIC_PASSWORD="xxxx-xxxx-xxxx-xxxx"   # appleid.apple.com → App-Specific Passwords
APPLE_TEAM_ID="XXXXXXXXXX"

# GitHub token (classic, `repo` scope) — used only to publish releases
GH_TOKEN="ghp_xxxxxxxxxxxxxxxxxxxx"
